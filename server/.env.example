# Copy to .env and fill real values. Do not commit secrets.
# Required keys match server/src/utils/envValidator.js — missing any of them exits the process.

# Server
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:8000

# MongoDB (required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
# Optional DB name appended in db.js when using Atlas without a path
# DB_Name=brandly

# JWT (required)
ACCESS_TOKEN_SECRET=change_me_long_random_access_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change_me_long_random_refresh_secret
REFRESH_TOKEN_EXPIRY=10d

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_API_VERSION=2024-11-20.acacia
PLATFORM_FEE_PERCENTAGE=10
MINIMUM_PAYOUT=5
MAXIMUM_SINGLE_PAYMENT=10000

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis / BullMQ (REDIS_HOST required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Email (OTP, contact, login alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google login (optional — button hidden if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep this in sync with Google Cloud Console. Both /auth and /users callbacks exist.
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/users/google/callback

# Platform OAuth (optional per network)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CALLBACK_URL=http://localhost:8000/api/v1/auth/youtube/callback
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
